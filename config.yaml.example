sftp:
  host: photos.example.com
  port: 22
  user: myuser

  # Authentication — use one of: password, key_path, or leave both blank to use ssh-agent.
  # key_path: ~/.ssh/id_rsa
  # password: secret

  remote_path: /photos

  # Set true to skip host key verification (not recommended for production).
  # insecure_ignore_host_key: false

# Local directory where photos will be synced to.
local_path: ~/Pictures/sftp-sync

sync:
  # How often to poll the SFTP server for changes.
  interval: 60s

  # Number of concurrent download goroutines.
  workers: 4

  # File extensions to sync. Leave empty to sync all files.
  extensions:
    - .jpg
    - .jpeg
    - .png
    - .raw
    - .heic
    - .tiff

  # How to organise synced photos into local folders.
  # - "none":            preserve the remote directory structure (default)
  # - "year":            YYYY/<filename>     e.g. ~/Pictures/2024/IMG_1234.jpg
  # - "year_month":      YYYY/MM/<filename>  e.g. ~/Pictures/2024/06/IMG_1234.jpg
  # - "year_month_day":  YYYY/MM/DD/<filename>  e.g. ~/Pictures/2024/06/15/IMG_1234.jpg
  #
  # The date is taken from EXIF DateTimeOriginal when available, falling back
  # to the remote directory structure when EXIF data cannot be read.
  folder_structure: year_month

# Path for the state manifest (tracks what has been synced).
# Defaults to ~/.local/share/sftpsync/manifest.json
# state_path: ~/.local/share/sftpsync/manifest.json
