sftp:
  host: photos.example.com
  port: 22
  user: myuser

  # Authentication — use one of: password, key_path, or leave both blank to use ssh-agent.
  # key_path: ~/.ssh/id_rsa
  # password: secret

  remote_path: /photos

  # Set true to skip host key verification (not recommended for production).
  # insecure_ignore_host_key: false

# Local directory where photos will be synced to.
local_path: ~/Pictures/sftp-sync

sync:
  # How often to poll the SFTP server for changes.
  interval: 60s

  # Number of concurrent download goroutines.
  workers: 4

  # File extensions to sync. Leave empty to sync all files.
  extensions:
    - .jpg
    - .jpeg
    - .png
    - .raw
    - .heic
    - .tiff

  # How to organise synced photos into local folders.
  # - "none":            preserve the remote directory structure (default)
  # - "year":            YYYY/<filename>     e.g. ~/Pictures/2024/IMG_1234.jpg
  # - "year_month":      YYYY/MM/<filename>  e.g. ~/Pictures/2024/06/IMG_1234.jpg
  # - "year_month_day":  YYYY/MM/DD/<filename>  e.g. ~/Pictures/2024/06/15/IMG_1234.jpg
  #
  # The date is taken from EXIF DateTimeOriginal when available, falling back
  # to the remote directory structure when EXIF data cannot be read.
  folder_structure: year_month

  # What to do when the destination for a file is already taken, which happens
  # when two remote files share a basename and a capture date.
  # - "rename": write IMG_0001-2.JPG beside an existing IMG_0001.JPG (default)
  # - "skip":   leave the existing file alone and report the file as skipped
  # - "error":  fail the file
  #
  # The destination chosen for each file is recorded in the manifest, so a
  # renamed file is updated in place on later syncs instead of being renamed
  # again.
  collision_policy: rename

  # How many times to attempt one file's transfer before reporting it failed.
  # Retries wait with exponential backoff and jitter, and only failures that look
  # transient (a dropped connection, a timeout, a truncated transfer) are
  # retried. A file that fails is retried again on the next poll.
  max_attempts: 3

  # How much work to do to be sure a local file really is the file the server is
  # offering.
  # - "size":   trust the manifest's modification time and size (default)
  # - "sha256": compare content hashes
  #
  # Either way, a local file is only adopted as an already-synced copy when its
  # size matches the remote file, so an empty or truncated file is not mistaken
  # for a finished download. sha256 mode additionally reads the remote file back,
  # which costs a second transfer per verified file.
  verify: size

# Path for the state manifest (tracks what has been synced).
# Defaults to ~/.local/share/sftpsync/manifest.json
# state_path: ~/.local/share/sftpsync/manifest.json
